{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Skill",
      "Bash(python tools/extract.py:*)",
      "Bash(python tools/srs.py:*)",
      "Bash(python tools/render.py:*)",
      "Bash(python tools/digest.py:*)"
    ],
    "deny": [
      "PowerShell"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/worklog_check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
